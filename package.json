{
  "name": "@strutvane/files",
  "version": "0.1.0-next.0",
  "description": "Cloud storage for Strutvane apps: S3 (and R2, MinIO, Spaces) and Azure Blob disks from config/filesystems.ts, presigned and resumable direct-to-cloud uploads, magic-byte validation, EXIF/GPS stripping, virus scanning with quarantine, per-tenant quotas and attachments with orphan cleanup.",
  "keywords": [
    "strutvane",
    "file-upload",
    "storage",
    "s3",
    "azure-blob",
    "minio",
    "r2",
    "image",
    "clamav",
    "typescript"
  ],
  "homepage": "https://github.com/vishwajit-vm/strutvane-files#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/strutvane-files/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/strutvane-files.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./provider": {
      "types": "./dist/provider.d.mts",
      "default": "./dist/provider.mjs"
    },
    "./installer": {
      "types": "./dist/installer.d.mts",
      "default": "./dist/installer.mjs"
    },
    "./s3": {
      "types": "./dist/s3.d.mts",
      "default": "./dist/s3.mjs"
    },
    "./azure": {
      "types": "./dist/azure.d.mts",
      "default": "./dist/azure.mjs"
    },
    "./images": {
      "types": "./dist/images.d.mts",
      "default": "./dist/images.mjs"
    },
    "./clamav": {
      "types": "./dist/clamav.d.mts",
      "default": "./dist/clamav.mjs"
    },
    "./sql": {
      "types": "./dist/sql.d.mts",
      "default": "./dist/sql.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "build": "tsdown",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "strutvane": {
    "id": "files",
    "name": "Cloud files",
    "description": "S3 and Azure Blob disks, presigned and resumable uploads, virus scanning, quotas",
    "category": "back-office",
    "tags": [
      "s3",
      "azure",
      "storage",
      "uploads"
    ],
    "compat": "^0.2.0-next.0",
    "installer": "./dist/installer.mjs",
    "docs": "https://github.com/vishwajit-vm/strutvane-files#readme"
  },
  "peerDependencies": {
    "@strutvane/framework": "^0.2.0-next.0",
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@azure/identity": "^4.10.0",
    "@azure/storage-blob": "^12.28.0",
    "sharp": "^0.35.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1168.0",
    "@aws-sdk/s3-request-presigner": "3.1168.0",
    "@azure/identity": "4.14.1",
    "@azure/storage-blob": "12.34.0",
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@strutvane/framework": "0.2.0-next.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
